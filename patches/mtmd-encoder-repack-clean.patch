+        /* use_extra_bufts   */ false,
     };
     return params;
 }
@@ -696,6 +697,7 @@ struct mtmd_context {
             /* progress_callback */ ctx_params.progress_callback,
             /* progress_callback_user_data */ ctx_params.progress_callback_user_data,
             /* n_threads                   */ ctx_params.n_threads,
+            /* use_extra_bufts             */ ctx_params.use_extra_bufts,
         };
 
         auto res = clip_init(mmproj_fname, ctx_clip_params);
diff --git a/tools/mtmd/mtmd.h b/tools/mtmd/mtmd.h
index 27763563c..ba402bad5 100644
--- a/tools/mtmd/mtmd.h
+++ b/tools/mtmd/mtmd.h
@@ -133,6 +133,10 @@ struct mtmd_context_params {
     // If it returns false, model loading is immediately aborted.
     mtmd_progress_callback progress_callback;
     void * progress_callback_user_data;
+
+    // allow the CPU encoder weights to use extra buffer types (e.g. runtime repacking of quantized weights),
+    // the same mechanism the language model uses (default: false; llama-mtmd-cli and llama-server follow --repack/--no-repack)
+    bool use_extra_bufts;
 };
 
 MTMD_API const char * mtmd_default_marker(void);
